# /opt/the-star/backend.env  (chmod 600) — backend settings. Same names as the
# backend's local .env, except DATABASE_URL (the stack's own database) and
# CORS_ORIGINS (from STAR_DOMAIN): docker-compose.yml sets those.

SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
ADMIN_USERNAME=

# Web Push for staff alerts (python -m app.core.push generates a pair).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:

# Where Paystack returns guests: the site's address (same as https://$STAR_DOMAIN).
FRONTEND_URL=https://

# Guest payments: "paystack" for real MoMo/card payments, "demo" moves no money.
PAYMENT_PROVIDER=paystack
# Paystack dashboard > Settings > API Keys & Webhooks (sk_test_... to rehearse, sk_live_... for real).
# Webhook URL there: https://$STAR_DOMAIN/api/payments/paystack/webhook
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=GHS

# Loyverse POS: "live" records each paid order as a sale; "simulated" keeps it in this database.
LOYVERSE_MODE=live
LOYVERSE_ACCESS_TOKEN=
LOYVERSE_STORE_ID=
LOYVERSE_MOMO_PAYMENT_TYPE=Mobile Money
LOYVERSE_CARD_PAYMENT_TYPE=Card
