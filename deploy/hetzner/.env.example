# /opt/the-star/.env  (chmod 600) — compose variables.

# The public address of the app (site and API), e.g. order.thestarbar.com.
STAR_DOMAIN=

# Cloudflare Zero Trust → Networks → Tunnels → the-star → install command token.
# Its public hostname must route $STAR_DOMAIN to http://router:80
TUNNEL_TOKEN=

# Database passwords: the postgres superuser, and the app's own login (star_app).
# Use hex (openssl rand -hex 32) so they're safe inside the database URL.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
