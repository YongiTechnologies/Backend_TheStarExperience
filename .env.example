# Copy to .env for local development and set the same keys in your host's
# environment settings for production. Never commit the real .env.

# PostgreSQL in production (postgres:// and postgresql:// both work and use psycopg2); SQLite works locally.
# Supabase: Project → Connect → "Session pooler" URI (port 5432). The direct
# db.<ref>.supabase.co host is IPv6-only, so hosts like Render can't reach it.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Signs staff login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

ALGORITHM=HS256
# How long a staff login lasts; 720 = a 12-hour event shift.
ACCESS_TOKEN_EXPIRE_MINUTES=720

# The only username allowed to use /api/admin endpoints (create it with create_admin.py).
ADMIN_USERNAME=admin

# Comma-separated frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
# Optional extra origin, kept for older deployments.
FRONTEND_URL=

# Web Push: alerts on waiters' phones while the screen is locked. Leave blank to turn off.
# Generate a pair once with:  python -m app.core.push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact address the push services (Google, Apple, Mozilla) can reach you at.
VAPID_SUBJECT=mailto:admin@example.com
