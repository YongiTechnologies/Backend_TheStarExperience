# Copy to .env for local development and set the same keys in your host's
# environment settings for production. Never commit the real .env.

# PostgreSQL in production (postgres:// and postgresql:// both work and use psycopg2); SQLite works locally.
# Supabase: Project → Connect → "Session pooler" URI (port 5432). The direct
# db.<ref>.supabase.co host is IPv6-only, so hosts like Render can't reach it.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Signs staff login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

ALGORITHM=HS256
# How long a staff login lasts; 720 = a 12-hour event shift.
ACCESS_TOKEN_EXPIRE_MINUTES=720

# The only username allowed to use /api/admin endpoints (create it with create_admin.py).
ADMIN_USERNAME=admin

# Comma-separated frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
# Optional extra origin, kept for older deployments.
FRONTEND_URL=

# Web Push: alerts on waiters' phones while the screen is locked. Leave blank to turn off.
# Generate a pair once with:  python -m app.core.push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact address the push services (Google, Apple, Mozilla) can reach you at.
VAPID_SUBJECT=mailto:admin@example.com

# Guest payments: "demo" (no money moves) or "paystack" (real MoMo and card payments).
PAYMENT_PROVIDER=demo
# Paystack dashboard > Settings > API Keys & Webhooks. sk_test_... while testing, sk_live_... to go live.
# Secret: backend only, never in the frontend.
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=GHS
# Where Paystack sends the guest after paying ("{order_id}" is filled in).
# Leave empty to use FRONTEND_URL/order/{order_id}.
PAYSTACK_CALLBACK_URL=
# Paystack needs an email per payment; guests only give a phone, so <phone>@this domain is used.
PAYSTACK_GUEST_EMAIL_DOMAIN=guests.thestar.republicbar.com
# Also set the webhook URL on the Paystack dashboard to https://<backend>/api/payments/paystack/webhook

# Loyverse POS: each paid order becomes a sales receipt there.
# "live" uses the Loyverse API; "simulated" stores receipts in this database (no account needed); "off" skips it.
LOYVERSE_MODE=simulated
# Live mode: Back Office > Integrations > Access tokens. Treat it like a password.
LOYVERSE_ACCESS_TOKEN=
# Live mode: only needed if the Loyverse account has more than one store.
LOYVERSE_STORE_ID=
# Live mode: the Loyverse payment type names that MoMo and card payments are recorded under.
LOYVERSE_MOMO_PAYMENT_TYPE=Mobile Money
LOYVERSE_CARD_PAYMENT_TYPE=Card
# Live mode: send demo (no money collected) payments to Loyverse as real sales. Keep false
# except for a deliberate end-to-end test.
LOYVERSE_SYNC_DEMO_PAYMENTS=false
# Simulated mode only: pretend Loyverse is down, to show payments surviving an outage.
LOYVERSE_SIMULATE_OUTAGE=false
